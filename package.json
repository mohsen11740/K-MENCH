{
  "name": "k-mench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:server": "wrangler deploy --config wrangler.toml",
    "dev:server": "wrangler dev --config wrangler.toml",
    "desktop:build": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "~5.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.45.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.8",
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "ir.baran.kmench",
    "productName": "BM baran-mench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "BM-baran-mench-Windows-${version}.${ext}"
    }
  }
}
